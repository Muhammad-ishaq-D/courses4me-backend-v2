{
  "name": "courses4me-backend",
  "version": "1.0.0",
  "description": "Courses4Me backend v2 — Node.js + Express + MySQL API (customer portal, admin panel)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "exit 0",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "check": "npm audit --omit=dev && npm test",
    "migrate": "knex migrate:latest",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "seed:admin": "node scripts/create_admin.js",
    "postman:auth": "node scripts/update_postman_auth.js",
    "postman:courses": "node scripts/update_postman_courses.js",
    "postman": "npm run postman:auth && npm run postman:courses && npm run postman:locations && npm run postman:bookings && npm run postman:admin",
    "postman:locations": "node scripts/update_postman_locations.js",
    "postman:bookings": "node scripts/update_postman_bookings.js",
    "postman:admin": "node scripts/update_postman_admin.js"
  },
  "keywords": [
    "express",
    "mysql",
    "knex",
    "jwt",
    "courses"
  ],
  "author": "CodeHaven Solutions",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "stripe": "^22.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "clearMocks": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
