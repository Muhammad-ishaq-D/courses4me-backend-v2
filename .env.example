# Server
PORT=5000
NODE_ENV=development
# LOG_LEVEL=debug|info|warn|error (default: debug outside production)
# DISABLE_CRON=true

# MySQL (Hostinger / local). Schema is created with `npm run migrate`.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=courses4me_db

# Security — the app refuses to start without these two. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Brute-force protection
# Per-account lockout after this many wrong passwords, for this many minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Forgot-password emails allowed per account per hour
RESET_MAX_PER_HOUR=3
# Requests per IP per 15 minutes across the whole API
API_RATE_LIMIT=300

# Cloudinary (profile photos, course thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontends (used for CORS and for links in emails / OAuth redirects)
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
# Extra CORS origins allowed in ANY environment (comma-separated)
# DEV_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (SMTP). Required in production. Leave empty in development to use an
# Ethereal test inbox (messages are not delivered; a preview URL is logged).
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=noreply@courses4me.co.uk
FROM_NAME=Courses4Me

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# First admin account for `npm run seed:admin` (or pass --email/--password)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
