    {
      "name": "2. Admin Auth",
      "description": "Admin panel login and OTP password reset. Login stores {{adminToken}}; Verify OTP stores {{reset_token}}.",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Admin panel login. A login from a new device (user-agent + IP) raises an admin notification. 5 wrong passwords lock the account for 15 minutes (423 ACCOUNT_LOCKED).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged in\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "var body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set(\"adminToken\", body.token); }",
                  "if (body.user && body.user.id) { pm.collectionVariables.set(\"userId\", body.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password (send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Always answers 200 with a generic message. Emails a 6-digit OTP valid for 10 minutes (max 3 emails per account per hour).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Generic success\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Exchange the emailed code (field `code` or `otp`) for a single-use reset token valid 10 minutes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData;",
                  "try { jsonData = pm.response.json(); } catch (error) { throw new Error(\"Verify OTP response is not valid JSON\"); }",
                  "pm.test(\"OTP verified\", function () { pm.expect(jsonData.success).to.eql(true); });",
                  "if (jsonData.success && jsonData.data && jsonData.data.resetToken) {",
                  "    pm.collectionVariables.set(\"reset_token\", jsonData.data.resetToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "reset-password"
              ]
            },
            "description": "Consumes {{reset_token}}, sets the password and logs every session out.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{reset_token}}\",\n  \"newPassword\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Password reset\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
