{
  "info": {
    "name": "Courses4Me API v2",
    "description": "Courses4Me backend v2 (Express + MySQL). Collection variables hold test accounts only — never real customers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hostUrl}}/health",
              "host": [
                "{{hostUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Always 200; the db field is up|down. Every response carries an X-Request-Id header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API healthy\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"Database up\", function () { pm.expect(pm.response.json().db).to.eql(\"up\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication (Customer)",
      "description": "Customer portal signup/login and own-profile endpoints. Login stores {{token}}.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a customer account. Password: 8+ chars, one uppercase, one number, one symbol.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registered\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Customer login. Admin/editor accounts are refused here (use 2. Admin Auth). 5 wrong passwords lock the account for 15 minutes (423 ACCOUNT_LOCKED).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged in\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "var body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set(\"token\", body.token); }",
                  "if (body.user && body.user.id) { pm.collectionVariables.set(\"userId\", body.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Email",
